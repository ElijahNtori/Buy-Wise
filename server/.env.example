PORT=5000
NODE_ENV=development
CACHE_TTL=300

# RapidAPI (Multi-Marketplace Search)
RAPIDAPI_KEY=your_rapidapi_key
RAPIDAPI_AMAZON_HOST=real-time-amazon-data.p.rapidapi.com
RAPIDAPI_EBAY_HOST=ebay-search1.p.rapidapi.com
RAPIDAPI_WALMART_HOST=walmart-search-api.p.rapidapi.com

# Direct Marketplace Credentials (Optional - some adapters may use these)
AMAZON_ACCESS_KEY=your_amazon_access_key
AMAZON_SECRET_KEY=your_amazon_secret_key
AMAZON_PARTNER_TAG=your_tag
EBAY_CLIENT_ID=your_ebay_app_id
EBAY_CLIENT_SECRET=your_ebay_secret

# MongoDB (Optional)
MONGODB_URI=mongodb://localhost:27017/buywise

# Omkar Scrapers (Alibaba & AliExpress)
OMKAR_ALIBABA_KEY=your_omkar_key
OMKAR_ALI_KEY=your_omkar_key

# SerpApi (eBay High Performance Search)
SERPAPI_KEY=your_serpapi_key

# Security
JWT_SECRET=your_super_secret_jwt_key
FRONTEND_URL=http://localhost:3000
