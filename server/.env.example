PORT=5000
NODE_ENV=production
CACHE_TTL=300

# Frontend URL (CORS allowed origin — e.g. https://buywise.vercel.app)
FRONTEND_URL=https://buywise.vercel.app

# Backend URL (used to build verification emails — e.g. https://buywise-api.onrender.com)
BACKEND_URL=https://buywise-api.onrender.com

# ── Supabase Database Connection ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── JWT Authentication Secret ──────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_key

# ── NodeMailer SMTP Relay (Brevo Configuration) ──────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_brevo_registered_email@domain.com
SMTP_PASS=your_brevo_smtp_master_key
SMTP_FROM_EMAIL=your_brevo_verified_sender_email@domain.com
SMTP_FROM_NAME=Buy-Wise

# ── Direct Brevo HTTP API Option (Alternative to SMTP Relay) ──────────────
# If you configure BREVO_API_KEY, the server will send emails directly via
# Brevo's HTTP API. This is often faster and bypasses SMTP authentication issues.
# Use your Brevo API key (starts with "xkeysib-") and verified sender address.
BREVO_API_KEY=your_brevo_api_key_here
MAIL_ADDRESS=your_brevo_verified_sender_email@domain.com
SMTP_FROM_NAME=Buy-Wise

# ── Amazon Scraper (Omkar Cloud) ──────────────────────────────────────────
OMKAR_AMAZON_KEY=your_omkar_key

# ── SerpApi (eBay) ────────────────────────────────────────────────────────
SERPAPI_KEY=your_serpapi_key

# ── Omkar Scrapers ────────────────────────────────────────────────────────
OMKAR_ALIEXPRESS_KEY=your_omkar_key
OMKAR_ALIBABA_KEY=your_omkar_key

# ── Currency & Conversion ──────────────────────────────────────────────────
OMKAR_CONVERSION_KEY=your_omkar_key
EXCHANGE_RATE_USD_GHS=14.50
FIXER_API_KEY=your_fixer_api_key
